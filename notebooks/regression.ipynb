    "## 4. Regression Modelling\n",
    "\n",
    "Multiple regression algorithms are trained and evaluated to compare their ability to predict house prices. The models represent different approaches, including linear, regularized linear, polynomial, tree-based, ensemble, distance-based, and support vector regression methods."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 84,
   "id": "456828b5-0c12-4449-b02e-6b3b17cd9e9a",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import time"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 85,
   "id": "c55f0f2c-12ec-42a5-9a02-c95590da6aa0",
   "metadata": {},
   "outputs": [],
   "source": [
    "results = []\n",
    "\n",
    "def evaluate_model(model_name, model, X_train, X_test, y_train, y_test):\n",
    "    start_time = time.time()\n",
    "    \n",
    "    model.fit(X_train, y_train)\n",
    "    predictions = model.predict(X_test)\n",
    "    \n",
    "    mae = mean_absolute_error(y_test, predictions)\n",
    "    rmse = np.sqrt(mean_squared_error(y_test, predictions))\n",
    "    r2 = r2_score(y_test, predictions)\n",
    "    \n",
    "    training_time = time.time() - start_time\n",
    "    \n",
    "    results.append({\n",
    "        'Model': model_name,\n",
    "        'MAE': mae,\n",
    "        'RMSE': rmse,\n",
    "        'R2': r2,\n",
    "        'Training Time (s)': training_time\n",
    "    })\n",
    "    \n",
    "    print(f\"{model_name}\")\n",
    "    print(f\"MAE  : {mae:.4f}\")\n",
    "    print(f\"RMSE : {rmse:.4f}\")\n",
    "    print(f\"R²   : {r2:.4f}\")\n",
    "    print(f\"Time : {training_time:.4f} seconds\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 86,
   "id": "5f75a795-ee1f-4c09-986d-bbf334508ea4",
