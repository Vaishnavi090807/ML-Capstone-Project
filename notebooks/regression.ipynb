   "source": [
    "def convert_sqft_to_num(x):\n",
    "    try:\n",
    "        if '-' in str(x):\n",
    "            tokens = str(x).split('-')\n",
    "            return (float(tokens[0]) + float(tokens[1])) / 2\n",
    "        return float(x)\n",
    "    except:\n",
    "        return np.nan\n",
    "eda_df['new_total_sqft'] = eda_df['total_sqft'].apply(convert_sqft_to_num)"
   ]
  },
