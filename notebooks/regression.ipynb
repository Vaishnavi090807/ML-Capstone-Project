      "MAE  : 17.0487\n",
      "RMSE : 22.4611\n",
      "R²   : 0.5088\n",
      "Time : 1.5520 seconds\n"
     ]
    }
   ],
   "source": [
    "from sklearn.ensemble import RandomForestRegressor\n",
    "\n",
    "random_forest_model = RandomForestRegressor(\n",
    "    n_estimators=100,\n",
    "    random_state=RANDOM_STATE,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "evaluate_model(\n",
    "    \"Random Forest Regressor\",\n",
    "    random_forest_model,\n",
    "    X_train,\n",
    "    X_test,\n",
    "    y_train,\n",
    "    y_test\n",
    ")"
