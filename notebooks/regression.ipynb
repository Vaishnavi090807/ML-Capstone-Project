     ]
    }
   ],
   "source": [
    "from sklearn.tree import DecisionTreeRegressor\n",
    "\n",
    "decision_tree_model = DecisionTreeRegressor(\n",
    "    random_state=RANDOM_STATE\n",
    ")\n",
    "\n",
    "evaluate_model(\n",
    "    \"Decision Tree Regressor\",\n",
    "    decision_tree_model,\n",
    "    X_train,\n",
    "    X_test,\n",
    "    y_train,\n",
    "    y_test\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
